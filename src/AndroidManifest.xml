<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lamireuxp.classroom"
    android:versionCode="11"
    android:versionName="1.5">

    <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 待办提醒：到点发通知。API 33 起是运行时权限，在设置提醒那一刻申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 闹钟不跨重启，开机后必须重排一遍，否则所有提醒静默失效 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      targetSdk >= 30 会启用包可见性过滤：不声明下面这条，
      SpeechRecognizer.isRecognitionAvailable() 查询不到任何
      android.speech.RecognitionService（如小米的 com.xiaomi.mibrain.speech），
      会直接返回 false，导致语音功能「无法启动」。
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>

        <!--
          设备侧识别放行（厂商 CTA / 机型白名单）要在厂商语音助手里同意一次，
          VoiceAuth 需要能解析到它们的启动入口；同理需要系统「语音输入」设置页。
          包可见性过滤对 getLaunchIntentForPackage 和隐式 Intent 都生效，
          不在这里声明就会全部解析不到、点了「去授权」没有任何反应。
        -->
        <package android:name="com.miui.voiceassist" />
        <package android:name="com.heytap.speechassist" />
        <package android:name="com.coloros.speechassist" />
        <package android:name="com.vivo.voiceassist" />
        <package android:name="com.vivo.ai" />
        <package android:name="com.huawei.vassistant" />
        <package android:name="com.hihonor.vassistant" />
        <package android:name="com.meizu.voiceassist" />
        <package android:name="com.samsung.android.bixby.agent" />
        <intent>
            <action android:name="android.settings.VOICE_INPUT_SETTINGS" />
        </intent>
        <!-- 小米识别服务自带的授权弹窗（VoiceAuth 第一优先拉它，见实测） -->
        <intent>
            <action android:name="com.xiaomi.mibrain.speech.cta" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CourseActivity"
            android:label="@string/app_name"
            android:parentActivityName=".MainActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:exported="false" />

        <activity
            android:name=".AllTodosActivity"
            android:label="全部待办"
            android:parentActivityName=".MainActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:exported="false" />

        <activity
            android:name=".TrashActivity"
            android:label="回收站"
            android:parentActivityName=".SettingsActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:label="设置"
            android:parentActivityName=".MainActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:exported="false" />

        <activity
            android:name=".AiSettingsActivity"
            android:label="AI 总结设置"
            android:parentActivityName=".SettingsActivity"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:exported="false" />

        <activity
            android:name=".TsSettingsActivity"
            android:label="语音转写设置"
            android:parentActivityName=".SettingsActivity"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:exported="false" />

        <!--
          提醒闹钟的落点。exported=false 足够：PendingIntent 由本应用自己创建，
          系统按身份投递，不需要对外暴露。
        -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!--
          开机重排。BOOT_COMPLETED 是系统受保护广播，必须 exported=true 才收得到；
          因为发不出这个广播，第三方无法伪造触发。
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>