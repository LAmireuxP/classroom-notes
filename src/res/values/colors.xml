<?xml version="1.0" encoding="utf-8"?>
<!--
  色板 · 按 docs/DESIGN.md 的 token 体系。
  浅色 = Notion 暖纸系（暖白底 #FAFAF8 / 暖炭字 #37352F / 暖灰表面阶梯）；
  深色 = Notion 深色 + Linear 微调（中性深灰 #171717，不用纯黑）。
  primary 全局唯一强调色：只给主 CTA / 选中态 / 品牌标识，不做大面积铺色。
  改色注意：light_ 与 dark_ 必须成对改，漏一侧 tone() 会兜底纯黑/白。
-->
<resources>
