<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 浅色主题：MD3 Light -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/light_primary</item>
        <item name="android:colorPrimaryDark">@color/light_primary</item>
        <item name="android:colorAccent">@color/light_primary</item>
        <item name="android:windowBackground">@color/light_surface</item>
        <item name="android:textColorPrimary">@color/light_on_surface</item>
        <item name="android:textColorSecondary">@color/light_on_surface_variant</item>
        <item name="android:statusBarColor">@color/light_surface</item>
        <item name="android:navigationBarColor">@color/light_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 深色主题：MD3 Dark -->
    <style name="AppTheme.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/dark_primary</item>
        <item name="android:colorPrimaryDark">@color/dark_surface</item>
        <item name="android:colorAccent">@color/dark_primary</item>
        <item name="android:windowBackground">@color/dark_surface</item>
        <item name="android:textColorPrimary">@color/dark_on_surface</item>
        <item name="android:textColorSecondary">@color/dark_on_surface_variant</item>
        <item name="android:statusBarColor">@color/dark_surface</item>
        <item name="android:navigationBarColor">@color/dark_surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 透明对话框（MD3 Dialog / Bottom Sheet 用） -->
    <style name="TransparentDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>